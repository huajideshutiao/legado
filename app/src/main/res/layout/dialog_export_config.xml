<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="ifContentScrolls"
    android:paddingStart="@dimen/arco_spacing_lg"
    android:paddingEnd="@dimen/arco_spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/export_file_name"
            app:helperText="Variable: name, author">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arco_spacing_md"
            android:text="@string/export_type"
            android:textColor="@color/primaryText"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rg_export_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/arco_spacing_xs"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_type_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="txt" />

            <RadioButton
                android:id="@+id/rb_type_epub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:gravity="center"
                android:text="epub" />

            <RadioButton
                android:id="@+id/rb_type_cbz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:clickable="false"
                android:enabled="false"
                android:focusable="false"
                android:gravity="center"
                android:text="cbz" />

        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/export_charset">

            <io.legado.app.ui.widget.text.AutoCompleteTextView
                android:id="@+id/et_charset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cb_no_chapter_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/export_no_chapter_name" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
