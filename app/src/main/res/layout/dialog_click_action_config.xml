<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/translucent">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="3"
        android:rowCount="3">

        <TextView
            android:id="@+id/tv_top_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="上一页" />

        <TextView
            android:id="@+id/tv_top_center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="上一页" />

        <TextView
            android:id="@+id/tv_top_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="下一页" />

        <TextView
            android:id="@+id/tv_middle_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="上一页" />

        <TextView
            android:id="@+id/tv_middle_center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:text="@string/menu"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_middle_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="下一页" />

        <TextView
            android:id="@+id/tv_bottom_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="上一页" />

        <TextView
            android:id="@+id/tv_bottom_center"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="下一页" />

        <TextView
            android:id="@+id/tv_bottom_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:background="@drawable/shape_translucent_card"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="下一页" />

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/arco_spacing_lg"
        android:background="@drawable/shape_translucent_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/arco_spacing_lg"
        android:paddingTop="@dimen/arco_spacing_default"
        android:paddingEnd="@dimen/arco_spacing_lg"
        android:paddingBottom="@dimen/arco_spacing_default">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/click_regional_config"
            android:textColor="@color/white" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close"
            android:padding="@dimen/arco_spacing_xs"
            android:src="@drawable/ic_baseline_close"
            app:tint="@color/white" />

    </LinearLayout>

</FrameLayout>
