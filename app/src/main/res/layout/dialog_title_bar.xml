<?xml version="1.0" encoding="utf-8"?><!-- Dialog 专用 TitleBar 模板：被 BaseDialogFragment 在 useDefaultTitleBar=true 时 inflate。
     - attachToActivity=false：避免污染宿主 Activity 的 ActionBar
     - displayHomeAsUp=false：基类代码自管 navigationIcon 与点击 dismiss
     - fitStatusBar=false：Dialog 不需要状态栏 padding -->
<io.legado.app.ui.widget.TitleBar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="?attr/actionBarStyle"
    app:attachToActivity="false"
    app:contentInsetStartWithNavigation="0dp"
    app:displayHomeAsUp="false"
    app:fitStatusBar="false"
    app:popupTheme="@style/AppTheme.PopupOverlay"
    app:titleTextAppearance="@style/ToolbarTitle" />
