<?xml version="1.0" encoding="utf-8"?><!-- Arco: 书源校验进度控件，替代底部可交互 Snackbar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/arco_spacing_md"
    android:layout_marginVertical="@dimen/arco_spacing_default"
    android:background="@drawable/card_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/arco_spacing_lg"
    android:paddingVertical="@dimen/arco_spacing_md"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/progress_check_source"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="@dimen/arco_spacing_default" />

    <TextView
        android:id="@+id/tv_check_source_msg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/primaryText"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_check_source_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/arco_spacing_default"
        android:paddingVertical="@dimen/arco_spacing_xs"
        android:text="@string/cancel"
        android:textColor="@color/arco_primary"
        android:textSize="14sp" />

</LinearLayout>
