<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/arco_spacing_lg">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/theme_name">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/rg_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/day"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/rb_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/night"
                tools:ignore="TouchTargetSizeCheck" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/row_accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/accent"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <com.jaredrummler.android.colorpicker.ColorPanelView
                android:id="@+id/cpv_accent"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cpv_colorShape="circle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/background_color"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <com.jaredrummler.android.colorpicker.ColorPanelView
                android:id="@+id/cpv_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cpv_colorShape="circle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_bbg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/navbar_color"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <com.jaredrummler.android.colorpicker.ColorPanelView
                android:id="@+id/cpv_bbg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cpv_colorShape="circle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_bg_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/background_image"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_bg_image_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:textColor="@color/secondaryText"
                android:textSize="13sp"
                tools:text="@string/select_image" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_bg_image_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:padding="@dimen/arco_spacing_default"
                android:src="@drawable/ic_baseline_close"
                android:tint="@color/secondaryText"
                android:tooltipText="@string/delete"
                android:visibility="gone"
                tools:ignore="UnusedAttribute" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_blur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/background_image_blurring"
                android:textColor="@color/primaryText"
                android:textSize="15sp" />

            <io.legado.app.ui.widget.seekbar.ThemeSeekBar
                android:id="@+id/sb_blur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="25"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tv_blur_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"
                android:textAlignment="textEnd"
                android:textColor="@color/primaryText"
                android:textSize="15sp"
                tools:text="0" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/arco_spacing_md"
                android:padding="@dimen/arco_spacing_default"
                android:text="@string/cancel" />

            <io.legado.app.ui.widget.text.AccentTextView
                android:id="@+id/btn_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/arco_spacing_default"
                android:text="@string/ok" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
