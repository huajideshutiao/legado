<?xml version="1.0" encoding="utf-8"?>
<io.legado.app.ui.widget.AutoShrinkLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/dialog_title_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.legado.app.ui.widget.recycler.scroller.FastScrollRecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="none"
            tools:ignore="SpeakableTextPresentCheck" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/rotate_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/arco_spacing_default"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorSize="36dp"
            app:trackThickness="2dp" />

        <TextView
            android:id="@+id/tv_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/arco_spacing_lg"
            android:textColor="@color/secondaryText"
            android:visibility="gone" />

        <!-- 空态提示，列表为空时由代码设 visible -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/secondaryText"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 底部按钮栏，默认隐藏，需要按钮的 Dialog 由代码设 bottomLayout visible -->
    <LinearLayout
        android:id="@+id/bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/arco_view_height_max"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/arco_spacing_default"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_footer_left"
            style="@style/Widget.Arco.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:text="action"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_cancel"
            style="@style/Widget.Arco.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_ok"
            style="@style/Widget.Arco.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ok"
            android:textColor="@color/arco_btn_text_outline"
            android:visibility="gone"
            tools:ignore="RtlHardcoded"
            tools:visibility="visible" />

    </LinearLayout>

</io.legado.app.ui.widget.AutoShrinkLinearLayout>
