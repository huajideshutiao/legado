<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/dialog_title_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/arco_spacing_lg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/rg_footer"
                android:layout_width="0dp"
                android:layout_height="@dimen/arco_view_height_large"
                android:text="@string/manga_header_footer"
                android:textColor="@color/primaryText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manga_header_chapter"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/cb_chapter_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/cb_chapter_label" />

            <CheckBox
                android:id="@+id/cb_chapter_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:layout_marginTop="@dimen/arco_spacing_default"
                android:text="@string/manga_check_chapter_label"
                app:layout_constraintStart_toEndOf="@id/tv_chapter"
                app:layout_constraintTop_toBottomOf="@id/rg_footer" />

            <CheckBox
                android:id="@+id/cb_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_md"
                android:text="@string/manga_check_chapter"
                app:layout_constraintBottom_toBottomOf="@id/cb_chapter_label"
                app:layout_constraintStart_toEndOf="@id/cb_chapter_label"
                app:layout_constraintTop_toTopOf="@id/cb_chapter_label" />

            <CheckBox
                android:id="@+id/cb_chapter_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_md"
                android:text="@string/manga_check_chapter_name"
                app:layout_constraintBottom_toBottomOf="@id/cb_chapter_label"
                app:layout_constraintStart_toEndOf="@id/cb_chapter"
                app:layout_constraintTop_toTopOf="@id/cb_chapter_label" />

            <TextView
                android:id="@+id/tv_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manga_header_page"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/cb_page_number_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/cb_page_number_label" />

            <CheckBox
                android:id="@+id/cb_page_number_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:layout_marginTop="@dimen/arco_spacing_default"
                android:text="@string/manga_check_page_label"
                app:layout_constraintStart_toEndOf="@id/tv_page"
                app:layout_constraintTop_toBottomOf="@id/cb_chapter_label" />

            <CheckBox
                android:id="@+id/cb_page_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_md"
                android:text="@string/manga_check_page_number"
                app:layout_constraintBottom_toBottomOf="@id/cb_page_number_label"
                app:layout_constraintStart_toEndOf="@id/cb_page_number_label"
                app:layout_constraintTop_toTopOf="@id/cb_page_number_label" />

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manga_header_progress"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/cb_progress_ratio_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/cb_progress_ratio_label" />

            <CheckBox
                android:id="@+id/cb_progress_ratio_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:layout_marginTop="@dimen/arco_spacing_default"
                android:text="@string/manga_check_progress_label"
                app:layout_constraintStart_toEndOf="@id/tv_progress"
                app:layout_constraintTop_toBottomOf="@id/cb_page_number_label" />

            <CheckBox
                android:id="@+id/cb_progress_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_md"
                android:text="@string/manga_check_progress"
                app:layout_constraintBottom_toBottomOf="@id/cb_progress_ratio_label"
                app:layout_constraintStart_toEndOf="@id/cb_progress_ratio_label"
                app:layout_constraintTop_toTopOf="@id/cb_progress_ratio_label" />

            <TextView
                android:id="@+id/tv_orientation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manga_header_orientation"
                android:textColor="@color/primaryText"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/rg_footer_orientation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/rg_footer_orientation" />

            <RadioGroup
                android:id="@+id/rg_footer_orientation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/arco_spacing_default"
                android:layout_marginTop="@dimen/arco_spacing_default"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@id/tv_orientation"
                app:layout_constraintTop_toBottomOf="@id/cb_progress_ratio_label">

                <RadioButton
                    android:id="@+id/rb_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manga_radio_left" />

                <RadioButton
                    android:id="@+id/rb_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/arco_spacing_md"
                    android:text="@string/manga_radio_center" />
            </RadioGroup>

            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_footer_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_chapter,cb_chapter_label,cb_chapter,cb_chapter_name,tv_page,cb_page_number_label,cb_page_number,tv_progress,cb_progress_ratio_label,cb_progress_ratio,tv_orientation,rg_footer_orientation" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
