<?xml version="1.0" encoding="utf-8"?><!-- Arco Danger 按钮背景 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_radius_default" />
            <solid android:color="@color/arco_danger" />
            <!-- Alpha handling is better done in color or by system, but here we can't easily.
                 ArcoButton.kt handles this programmatically anyway. -->
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_radius_default" />
            <solid android:color="@color/arco_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_radius_default" />
            <solid android:color="@color/arco_danger" />
        </shape>
    </item>
</selector>
