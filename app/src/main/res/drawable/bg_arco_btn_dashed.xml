<?xml version="1.0" encoding="utf-8"?><!-- Arco Dashed 按钮背景：透明底 + 1dp 主色虚线边框（dashWidth=4dp / dashGap=3dp） -->
<!-- normal=透明底 + primary 虚线边 / pressed=fill_2 底 + primary_active 虚线边 / disabled=透明底 + fill_3 虚线边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/arco_fill_3" android:dashWidth="4dp" android:dashGap="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@color/arco_fill_2" />
            <stroke android:width="1dp" android:color="@color/arco_primary_active" android:dashWidth="4dp" android:dashGap="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/arco_primary" android:dashWidth="4dp" android:dashGap="3dp" />
        </shape>
    </item>
</selector>
