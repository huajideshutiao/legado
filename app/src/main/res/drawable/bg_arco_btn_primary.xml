<?xml version="1.0" encoding="utf-8"?><!-- Arco Primary 按钮背景：主色实心填充 -->
<!-- normal=arco_primary / pressed=arco_primary_active / disabled=arco_primary_disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@color/arco_primary_disabled" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@color/arco_primary_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@color/arco_primary" />
        </shape>
    </item>
</selector>
