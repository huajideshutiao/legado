<?xml version="1.0" encoding="utf-8"?><!-- Arco Outline 按钮背景：透明底 + 1dp 主色实线边框 -->
<!-- normal=透明底 + primary 边 / pressed=fill_2 底 + primary_active 边 / disabled=透明底 + fill_3 边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/arco_fill_3" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@color/arco_fill_2" />
            <stroke android:width="1dp" android:color="@color/arco_primary_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/arco_btn_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/arco_primary" />
        </shape>
    </item>
</selector>
