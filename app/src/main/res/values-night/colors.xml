    <!--statusBarBackground-->

    <!-- ==================== Arco Design Dark 色板（覆盖 light） ==================== -->
    <!-- 主色 arcoblue-6 dark（暗色主色更亮以保证对比度） -->
    <color name="arco_primary">#FF3C7EFF</color>
    <!-- 主色 disabled dark（arcoblue-3 dark，用于按钮 disabled 态填充） -->
    <color name="arco_primary_disabled">#FF2748A5</color>
    <!-- 填充色 dark fill-1/2/3（同 light，全部去掉冷偏用纯灰） -->
    <color name="arco_fill_1">#FF171717</color>
    <color name="arco_fill_2">#FF232323</color>
    <color name="arco_fill_3">#FF2A2A2A</color>
    <!-- 文字色阶 dark text-1/2/3 -->
    <color name="arco_text_1">#FFF8F8F8</color>
    <color name="arco_text_2">#FFCDCDCD</color>
    <!-- 边框 dark -->
    <!-- 卡片背景 dark -->
    <!-- ThemeConfig 默认色引用（dark 覆盖 light 同名，由系统 nightMode 自动选择） -->
    <color name="arco_default_accent">@color/arco_primary</color>
    <color name="arco_default_bg">@color/arco_fill_1</color>
    <color name="arco_default_bbg">@color/arco_fill_2</color>
