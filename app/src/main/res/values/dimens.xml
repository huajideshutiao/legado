<resources>
    <dimen name="font_size_normal">14sp</dimen>
    <dimen name="font_size_middle">16sp</dimen>
    <dimen name="font_size_large">18sp</dimen>

    <dimen name="fast_scroll_min_thumb_height">24dp</dimen>

    <dimen name="desc_icon_size">18sp</dimen>

    <!-- ==================== Arco Design 圆角体系 ==================== -->
    <dimen name="arco_radius_sm">4dp</dimen>
    <dimen name="arco_radius_default">8dp</dimen>
    <dimen name="arco_radius_lg">16dp</dimen>

    <!-- ==================== Arco Design 尺寸体系 ==================== -->
    <dimen name="arco_view_height_mini">24dp</dimen>
    <dimen name="arco_view_height_small">28dp</dimen>
    <dimen name="arco_view_height_default">32dp</dimen>
    <dimen name="arco_view_height_large">40dp</dimen>
    <dimen name="arco_view_height_xl">48dp</dimen>
    <dimen name="arco_view_height_max">56dp</dimen>

    <!-- ==================== Arco Design 间距体系 ==================== -->
    <dimen name="arco_spacing_xs">4dp</dimen>
    <dimen name="arco_spacing_default">8dp</dimen>
    <dimen name="arco_spacing_md">12dp</dimen>
    <dimen name="arco_spacing_lg">16dp</dimen>
    <dimen name="arco_spacing_max">20dp</dimen>

    <!-- ==================== Arco Design 语义化边距 ==================== -->
    <!-- 页面左右留白 -->
    <dimen name="arco_page_padding_h">@dimen/arco_spacing_lg</dimen>
    <!-- 对话框内容区水平内边距 -->
    <dimen name="arco_dialog_padding_h">@dimen/arco_spacing_lg</dimen>
    <!-- 对话框内容区垂直内边距（标题下方/按钮上方） -->
    <dimen name="arco_dialog_padding_v">@dimen/arco_spacing_default</dimen>
    <!-- 组件间距 -->
    <dimen name="arco_component_gap">@dimen/arco_spacing_default</dimen>

    <dimen name="fastscroll_bubble_radius">25dp</dimen>
    <dimen name="fastscroll_bubble_size">50dp</dimen>
    <dimen name="fastscroll_bubble_textsize">20sp</dimen>
    <dimen name="fastscroll_bubble_padding">8dp</dimen>

    <dimen name="fastscroll_handle_height">100dp</dimen>
    <dimen name="fastscroll_handle_width">5dp</dimen>
    <dimen name="fastscroll_handle_radius">2.5dp</dimen>

    <dimen name="fastscroll_track_width">2dp</dimen>

    <dimen name="fastscroll_scrollbar_margin_top">0dp</dimen>
    <dimen name="fastscroll_scrollbar_margin_bottom">0dp</dimen>
    <dimen name="fastscroll_scrollbar_padding_start">10dp</dimen>
    <dimen name="fastscroll_scrollbar_padding_end">0dp</dimen>

    <dimen name="fixed_height_bottom_padding">8dp</dimen>
</resources>