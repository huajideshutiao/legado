<?xml version="1.0" encoding="utf-8"?><!-- manifest 的 android:label 只能引用 aapt 资源 (安装时由系统解析, 进程未起,
     读不到 Compose Resources), 故应用名保留 xml。其余文案一律走 shared composeResources。
     content_select_action 菜单是 ActionMode 原生菜单, 同样只能引用 aapt 资源, 属同类例外。 -->
<resources>
    <string name="app_name">Legado</string>

    <!-- 文本选择浮动菜单 (ActionMode, aapt-only) -->
    <string name="menu_replace">替换</string>
    <string name="menu_bookmark">书签</string>
    <string name="menu_aloud">朗读</string>
    <string name="menu_dict">字典</string>
    <string name="menu_search_content">全文搜索</string>
    <string name="menu_browser">浏览器</string>
    <string name="menu_share_str">分享</string>
</resources>
