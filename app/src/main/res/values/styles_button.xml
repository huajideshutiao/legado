<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== Arco Design Button 规范 ==================== -->
    <!-- 参考：https://arco.design/vue/component/button
         5 种类型 × 4 种尺寸 × 3 种状态（normal/pressed/disabled）
         说明：parent 用 android:Widget，让 style 同时可用于 <Button> / <AppCompatButton> / <TextView>，
               匹配项目主流模式（TextView + selector 当按钮用）。 -->

    <!-- 基础样式（不直接使用，由 5 种类型继承）。默认尺寸 Default：高 32dp / paddingH 15dp / 14sp -->
    <style name="Widget.Arco.Button" parent="android:Widget">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/arco_btn_height_default</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_default</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_default</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/font_size_normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <!-- ===== 5 种类型（默认尺寸 Default） ===== -->

    <!-- Primary 主按钮：主色实心填充 + 白字，用于主要操作 -->
    <style name="Widget.Arco.Button.Primary" parent="Widget.Arco.Button">
        <item name="android:textColor">@color/arco_btn_text_primary</item>
        <item name="android:background">@drawable/bg_arco_btn_primary</item>
    </style>

    <!-- Secondary 次按钮（默认类型）：白底 + 灰边 + 深字，用于次要操作 -->
    <style name="Widget.Arco.Button.Secondary" parent="Widget.Arco.Button">
        <item name="android:textColor">@color/arco_btn_text_secondary</item>
        <item name="android:background">@drawable/bg_arco_btn_secondary</item>
    </style>

    <!-- Outline 描边按钮：主色边框 + 主色字 + 透明底，强调但弱于 Primary -->
    <style name="Widget.Arco.Button.Outline" parent="Widget.Arco.Button">
        <item name="android:textColor">@color/arco_btn_text_outline</item>
        <item name="android:background">@drawable/bg_arco_btn_outline</item>
    </style>

    <!-- Dashed 虚线按钮：主色虚线边框，常用于添加类操作 -->
    <style name="Widget.Arco.Button.Dashed" parent="Widget.Arco.Button">
        <item name="android:textColor">@color/arco_btn_text_dashed</item>
        <item name="android:background">@drawable/bg_arco_btn_dashed</item>
    </style>

    <!-- Text 文本按钮：无边框无背景，用于弱化操作 / 链接 -->
    <style name="Widget.Arco.Button.Text" parent="Widget.Arco.Button">
        <item name="android:textColor">@color/arco_btn_text_text</item>
        <item name="android:background">@drawable/bg_arco_btn_text</item>
    </style>

    <!-- ===== 5 类 × 4 尺寸 = 20 个组合 style（仅覆盖 height/paddingH/textSize） ===== -->
    <!-- 尺寸：Mini 24dp/8dp/12sp  Small 28dp/12dp/14sp  Default 32dp/15dp/14sp  Large 40dp/19dp/14sp -->

    <!-- Primary 尺寸变体 -->
    <style name="Widget.Arco.Button.Primary.Mini" parent="Widget.Arco.Button.Primary">
        <item name="android:layout_height">@dimen/arco_btn_height_mini</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Arco.Button.Primary.Small" parent="Widget.Arco.Button.Primary">
        <item name="android:layout_height">@dimen/arco_btn_height_small</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_small</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_small</item>
    </style>

    <style name="Widget.Arco.Button.Primary.Large" parent="Widget.Arco.Button.Primary">
        <item name="android:layout_height">@dimen/arco_btn_height_large</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_large</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_large</item>
    </style>

    <!-- Secondary 尺寸变体 -->
    <style name="Widget.Arco.Button.Secondary.Mini" parent="Widget.Arco.Button.Secondary">
        <item name="android:layout_height">@dimen/arco_btn_height_mini</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Arco.Button.Secondary.Small" parent="Widget.Arco.Button.Secondary">
        <item name="android:layout_height">@dimen/arco_btn_height_small</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_small</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_small</item>
    </style>

    <style name="Widget.Arco.Button.Secondary.Large" parent="Widget.Arco.Button.Secondary">
        <item name="android:layout_height">@dimen/arco_btn_height_large</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_large</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_large</item>
    </style>

    <!-- Outline 尺寸变体 -->
    <style name="Widget.Arco.Button.Outline.Mini" parent="Widget.Arco.Button.Outline">
        <item name="android:layout_height">@dimen/arco_btn_height_mini</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Arco.Button.Outline.Small" parent="Widget.Arco.Button.Outline">
        <item name="android:layout_height">@dimen/arco_btn_height_small</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_small</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_small</item>
    </style>

    <style name="Widget.Arco.Button.Outline.Large" parent="Widget.Arco.Button.Outline">
        <item name="android:layout_height">@dimen/arco_btn_height_large</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_large</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_large</item>
    </style>

    <!-- Dashed 尺寸变体 -->
    <style name="Widget.Arco.Button.Dashed.Mini" parent="Widget.Arco.Button.Dashed">
        <item name="android:layout_height">@dimen/arco_btn_height_mini</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Arco.Button.Dashed.Small" parent="Widget.Arco.Button.Dashed">
        <item name="android:layout_height">@dimen/arco_btn_height_small</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_small</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_small</item>
    </style>

    <style name="Widget.Arco.Button.Dashed.Large" parent="Widget.Arco.Button.Dashed">
        <item name="android:layout_height">@dimen/arco_btn_height_large</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_large</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_large</item>
    </style>

    <!-- Text 尺寸变体 -->
    <style name="Widget.Arco.Button.Text.Mini" parent="Widget.Arco.Button.Text">
        <item name="android:layout_height">@dimen/arco_btn_height_mini</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_mini</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Arco.Button.Text.Small" parent="Widget.Arco.Button.Text">
        <item name="android:layout_height">@dimen/arco_btn_height_small</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_small</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_small</item>
    </style>

    <style name="Widget.Arco.Button.Text.Large" parent="Widget.Arco.Button.Text">
        <item name="android:layout_height">@dimen/arco_btn_height_large</item>
        <item name="android:paddingStart">@dimen/arco_btn_padding_h_large</item>
        <item name="android:paddingEnd">@dimen/arco_btn_padding_h_large</item>
    </style>

</resources>
