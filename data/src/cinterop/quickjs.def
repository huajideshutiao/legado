package io.legado.app.napi.quickjs

// 导出 quickjs.h 的全部 extern API (JS_Eval / JS_GetPropertyStr / JS_GetLength /
// JS_GetOwnPropertyNames / JSPropertyEnum / JSAtom / JSValueTag 枚举等),
// 供 nativeMain 的 JS 桥接源码 (stage 进 leaf 后) 直接调用。
headers = quickjs.h

---

#include "quickjs.h"

// ============ C wrapper functions for static inline / macros ============
// cinterop 默认不绑定 static inline 函数 (其函数体依赖宏) 和带参数的宏,
// 此处提供 extern wrapper 函数让 Kotlin 端可调用。
// 仅包装 Kotlin 端 (IosJsEngine / OhosJsEngine) 需要使用的 API, 不改变 quickjs 行为。
// 命名前缀 qjs_ 避免与 quickjs.h 原生符号冲突。
// 单一数据源: iOS (iosArm64/iosSimulatorArm64) 与鸿蒙 (linuxArm64) 共用本文件 + quickjs-ng/ C 源码,
// cinterop 各自编译为对应 ABI 的库, 升级 quickjs-ng 时只需更新本目录一处。

// ---- JSValue 构造 (quickjs.h 中为 static inline, 依赖 JS_MKVAL 宏) ----
JSValue qjs_NewBool(JSContext *ctx, int val) { return JS_NewBool(ctx, val != 0); }
JSValue qjs_NewInt32(JSContext *ctx, int32_t val) { return JS_NewInt32(ctx, val); }
JSValue qjs_NewFloat64(JSContext *ctx, double val) { return JS_NewFloat64(ctx, val); }
JSValue qjs_NewString(JSContext *ctx, const char *str) { return JS_NewString(ctx, str); }
JSValue qjs_NewCFunction(JSContext *ctx, JSCFunction *func, const char *name, int length) {
    return JS_NewCFunction(ctx, func, name, length);
}

// ---- JSValue 类型判断 (quickjs.h 中为 static inline) ----
// 返回 int (0/1) 而非 bool, 简化 cinterop 类型映射
int qjs_IsException(JSValueConst v) { return (int)JS_IsException(v); }
int qjs_IsNumber(JSValueConst v) { return (int)JS_IsNumber(v); }
int qjs_IsBool(JSValueConst v) { return (int)JS_IsBool(v); }
int qjs_IsNull(JSValueConst v) { return (int)JS_IsNull(v); }
int qjs_IsUndefined(JSValueConst v) { return (int)JS_IsUndefined(v); }
int qjs_IsString(JSValueConst v) { return (int)JS_IsString(v); }
int qjs_IsObject(JSValueConst v) { return (int)JS_IsObject(v); }

// ---- JSValue 值提取 (quickjs.h 中为宏, cinterop 不绑定带参数宏) ----
int qjs_ValueGetTag(JSValueConst v) { return (int)JS_VALUE_GET_TAG(v); }
int32_t qjs_ValueGetInt(JSValueConst v) { return (int32_t)JS_VALUE_GET_INT(v); }
int32_t qjs_ValueGetBool(JSValueConst v) { return (int32_t)JS_VALUE_GET_BOOL(v); }
double qjs_ValueGetFloat64(JSValueConst v) { return (double)JS_VALUE_GET_FLOAT64(v); }

// ---- JSValue 字符串转换 (quickjs.h 中为 static inline, 调用 JS_ToCStringLen2) ----
const char *qjs_ToCString(JSContext *ctx, JSValueConst val) { return JS_ToCString(ctx, val); }

// ---- JSAtom 转字符串 (quickjs.h 中为 static inline, 调用 JS_AtomToCStringLen) ----
const char *qjs_AtomToCString(JSContext *ctx, JSAtom atom) { return JS_AtomToCString(ctx, atom); }

// ---- JS_FreeCString 适配: 其 const char* 参数被 cinterop 映射为 String?, 无法接收
// qjs_ToCString/qjs_AtomToCString 返回的 CPointer<ByteVar>?, 改走 void* 参数 (COpaquePointer?) ----
void qjs_FreeCString(JSContext *ctx, void *ptr) { JS_FreeCString(ctx, (const char *)ptr); }

// ---- Uint8Array/ArrayBuffer 指针传参适配: 各 target cinterop 对指针参数映射不一致
// (iOS=CPointer<Var>/COpaquePointer, ohos=NativePtr/Long), 统一走 uintptr_t 整数传指针
// (两端均映射 ULong), Kotlin 侧用 CPointer.rawValue / interpretCPointer 转换 ----

// ---- Uint8Array/ArrayBuffer 数据传递适配: 各 target cinterop 对指针参数映射不一致
// (官方 iOS=CPointer<Var>/COpaquePointer, CPF ohos=CPointer<CapturedType>/NativePtr),
// 统一用「数组参数」形式 (cinterop 生成 CValuesRef, Kotlin 直接传 ByteArray, 零指针转换) ----

// 拷贝版创建 Uint8Array (内部 malloc+memcpy+js_array_buffer_free 自管内存):
// Kotlin 侧无需分配/持有/free 回调, 无生命周期风险 (JS_NewUint8ArrayCopy 语义);
// 数组参数用 char[] (cinterop 映射 CValuesRef<ByteVar>, Kotlin ByteArray 直接传)
JSValue qjs_NewUint8ArrayCopy(JSContext *ctx, const char src[], size_t len) {
    return JS_NewUint8ArrayCopy(ctx, (const uint8_t *)src, len);
}

// 取 TypedArray 底层 ArrayBuffer 数据总长 (整数返回, 避免 out 指针参数跨端映射差异)
uintptr_t qjs_ArrayBufferSize(JSContext *ctx, JSValueConst obj) {
    size_t sz = 0;
    JS_GetArrayBuffer(ctx, &sz, obj);
    return (uintptr_t)sz;
}

// 从 ArrayBuffer 数据 offset 偏移处拷 min(cap, 剩余) 字节到 dst (dst 数组参数, Kotlin 传 ByteArray),
// 返回实际拷贝长度; 失败/越界返回 0
size_t qjs_ArrayBufferRead(JSContext *ctx, JSValueConst obj, size_t offset, char dst[], size_t cap) {
    size_t sz = 0;
    uint8_t *p = JS_GetArrayBuffer(ctx, &sz, obj);
    if (!p || offset >= sz || cap == 0) return 0;
    size_t n = (sz - offset) < cap ? (sz - offset) : cap;
    memcpy(dst, p + offset, n);
    return n;
}

// ---- 宏常量 (cinterop 不绑定带参数宏; 无参宏/字面量也非可调用符号, 统一 wrapper) ----
int qjs_EvalTypeGlobal(void) { return JS_EVAL_TYPE_GLOBAL; }

// JS_EVAL_FLAG_COMPILE_ONLY (bytecode 编译缓存: JS_Eval 编译不执行, 与 JS_EVAL_TYPE_GLOBAL 组合传 flags)
int qjs_EvalFlagCompileOnly(void) { return JS_EVAL_FLAG_COMPILE_ONLY; }

// ---- bytecode 编译缓存 (JS_WriteObject/JS_ReadObject 裸指针跨端映射差异, 统一包装:
//      缓冲区指针走 uintptr_t 整数, 数据走数组参数, Kotlin 零指针转换) ----

// 序列化 function object 为 bytecode (JS_WriteObject + JS_WRITE_OBJ_BYTECODE 语义):
// 返回缓冲区指针 (uintptr_t 整数, 0=失败), *plen 输出字节数;
// 缓冲区须 qjs_FreeBytecodeBuf 释放 (js_free)
uintptr_t qjs_WriteBytecode(JSContext *ctx, JSValueConst obj, size_t *plen) {
    size_t len = 0;
    uint8_t *buf = JS_WriteObject(ctx, &len, obj, JS_WRITE_OBJ_BYTECODE);
    if (!buf) return 0;
    *plen = len;
    return (uintptr_t)buf;
}

// 释放 qjs_WriteBytecode 返回的缓冲区 (js_free 语义)
void qjs_FreeBytecodeBuf(JSContext *ctx, uintptr_t buf) {
    js_free(ctx, (void *)buf);
}

// 反序列化 bytecode (JS_ReadObject + JS_READ_OBJ_BYTECODE 语义):
// src[] 数组参数形式 (cinterop 映射 CValuesRef, Kotlin ByteArray 直接传, 零指针转换,
// 与 qjs_NewUint8ArrayCopy 同模式)
JSValue qjs_ReadBytecode(JSContext *ctx, const char src[], size_t len) {
    return JS_ReadObject(ctx, (const uint8_t *)src, len, JS_READ_OBJ_BYTECODE);
}
