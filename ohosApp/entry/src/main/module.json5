{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 图片菜单"保存到相册"所需权限 (user_grant, 运行时经 abilityAccessCtrl 申请,
    // 见 Index.ets saveImageToGallery; photoAccessHelper.createAsset 写入图库需要)
    // 注: 不声明 ohos.permission.NOTIFICATION —— 本机 SDK 的 permissions.d.ts 权限联合类型与
    // toolchains/lib/PermissionDefinitions.json (735 条) 中都**不存在**该权限, 只有 11 个
    // 名称含 NOTIFICATION 的其它权限 (均非它); @ohos.notificationManager.d.ts 里
    // requestEnableNotification/isNotificationEnabled/publish 也均无 @permission 标注。
    // KMP 侧 core/src/ohosMain NotificationProgress.ohos.kt 类注释里"需声明该权限"的说法
    // 与本机 SDK 不符, 不要据此添加不存在的权限名 (会导致校验/安装失败)。
    "requestPermissions": [
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:permission_write_imagevideo_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      // 网络访问 (normal 级, system_grant 安装即授予), 与 Android 端
      // AndroidManifest 的 android.permission.INTERNET 对齐;
      // 未申报时 @ohos.net.http 全部请求失败 (HttpBridgeHandler 经它发真实请求)。
      {
        "name": "ohos.permission.INTERNET"
      },
      // 读剪贴板 (user_grant, 首次读取时弹窗申请): 书源/替换规则编辑页的
      // "从剪贴板粘贴" 经 PasteboardBridgeHandler 读系统剪贴板。
      // 拒绝授权时 PlatformCapabilities.getClipboardText 返回 null, 粘贴入口无内容。
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:permission_read_pasteboard_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      // 目录授权持久化 (fileShare.persistPermission/activatePermission, system_grant
      // 安装即授予; 本机 SDK PermissionDefinitions.json: availableLevel=normal,
      // provisionEnable=true): 2in1/平板上选书籍/备份目录后持久化临时授权, 重启后激活复用。
      // 仅具备 FolderAuthorization syscap 的设备实际执行 (ArkTS 侧 canIUse 检测)
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      // 来电状态监听 (system_grant, normal 级; 本机 SDK PermissionDefinitions.json 中
      // availableLevel=normal, provisionEnable=true): 朗读中来电自动暂停、
      // 结束后继续 (对照 Android 的 READ_PHONE_STATE + LISTEN_CALL_STATE)。
      // @ohos.telephony.observer.d.ts 的 on('callStateChange') 本身未标 @permission,
      // 但取号码/需受限号码时报错需要它, 故按常规惯例申报 (安装即授予, 不弹窗)。
      {
        "name": "ohos.permission.GET_TELEPHONY_STATE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon_layered",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:app_icon_foreground",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 长时任务类型与实现一致: 调用点全部在 ContinuousTaskArbiter.ets (音频绝对优先的申请/释放仲裁),
        // 三种类型各自对应一类业务 ——
        //   audioPlayback: 音频书/朗读/视频书播放 (MediaBridgeHandler 的 setBackgroundTask)
        //   multiDeviceConnection: Web 服务 (局域网内另一台设备连接本机服务)
        //   dataTransfer: 缓存书籍那种持续下载 (平台对它有额外硬要求: 应用必须持续更新进度,
        //     且更新通知必须是实况窗 —— 见 ContinuousTaskArbiter.publishTransferProgress)
        // 未在此声明的类型申请会被拒; 系统只校验到"该模式是否在配置里声明"这一步, 开源侧不存在
        // 业务一致性校验的实现, 被挂起/取消表现为原因码 (SYSTEM_CANCEL_* / SYSTEM_SUSPEND_*,
        // 触发方在系统调度服务).
        // 该 API 的 @permission 为 ohos.permission.KEEP_BACKGROUND_RUNNING (已在上面声明)。
        "backgroundModes": [
          "audioPlayback",
          "multiDeviceConnection",
          "dataTransfer"
        ],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          // legado:// / yuedu:// deep link (一键导入书源/替换规则/主题等),
          // 对照 Android AssociationActivity intent-filter (BROWSABLE + scheme legado/yuedu)。
          // 接线: EntryAbility onCreate/onNewWant 读 want.uri → napi 桥
          // (legado_napi.cpp @CName legado_handle_deep_link) → commonMain
          // LegadoDeepLinkHandler.handle (弹勾选导入对话框, 见 DeepLinkImportHost)
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [
              { "scheme": "legado" },
              { "scheme": "yuedu" }
            ]
          },
          // 文件关联: 系统把 txt/epub 等常见文档/压缩包/书源文件以 file:// 授权体 URI
          // 投递给本 Ability (onCreate/onNewWant 的 want.uri), 由 napi handleLaunchRequest
          // (@CName legado_handle_launch_request) 映射为 LaunchRequest.ImportFile 打开。
          // 对照 Android Manifest intent-filter (file 类型, 无 scheme 过滤)。
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "type": "text/plain"
              },
              {
                "type": "application/json"
              },
              {
                "type": "application/epub+zip"
              },
              // PDF 文件投递入口: scheme+type 同条目 (官方隐式 Want 匹配契约, want 的 uri 与
              // type 双非空时两者须均匹配), 本端经官方 PDFKit 真实渲染阅读
              {
                "scheme": "file",
                "type": "application/pdf"
              },
              {
                "type": "application/zip"
              },
              {
                "type": "application/octet-stream"
              },
              {
                "type": "text/xml"
              },
              // 视频投递入口: 逐条列具体 MIME (本 SDK modulecheck 将 skills.uris[].type 定义为
              // 自由字符串, 无通配匹配依据, 不用 video/* 通配)。申报以播放链承诺为界:
              // 文件容器按本机 SDK @ohos.multimedia.media.d.ts AVPlayer.url/fdSrc 明文
              // "The video formats MP4, MPEG-TS, and MKV are supported" 申报 video/mp4 /
              // video/x-matroska / video/mp2t; 同段明文 "WebM is no longer supported since
              // API version 11", webm 不申报; mov/flv/avi 不在承诺的容器清单, 不申报。
              // m3u8 仅限 http/https 两条 (官方隐式 Want 匹配契约: want 的 uri 与 type 双非空
              // 时条目内 scheme 与 type 须均匹配): 网络 HLS 进播放链 (SDK
              // createMediaSourceWithUrl 明文支持 HLS), 本地 .m3u8 播放列表文本不在文件容器
              // 承诺内, 不申报本地入口。
              // 上面的 application/octet-stream 保留不动: 投递方报不出具体类型时靠它兜底,
              // 命不命中视频由 KMP 侧按扩展名 / want.type 再判一次。
              {
                "type": "video/mp4"
              },
              {
                "type": "video/x-matroska"
              },
              {
                "type": "video/mp2t"
              },
              {
                "scheme": "http",
                "type": "application/vnd.apple.mpegurl"
              },
              {
                "scheme": "https",
                "type": "application/vnd.apple.mpegurl"
              }
            ]
          },
          // 接收其它应用分享的内容 (官方「应用内处理分享内容」契约): actions 配
          // ohos.want.action.sendData, uris 穷举支持的 UTD; "scheme为预留字段，在此处不生效"
          // (scheme=file 仅为满足 modulecheck schema 的 required:["scheme"]), 实际匹配按 utd;
          // maxFileSupported 标识归属该类型的文件一次可接收的最大数量, 缺省 0 = 不支持,
          // 单文件接收申报 1 (官方同文档)。
          // 消费面 (EntryAbility.handleSharedData): 官方契约 uri 载荷 = 应用/用户文件 URI
          // (链接与文本走 content), 以 file:// 形态为文件记录 —— 附件优先于附带文字
          // (对照 Android SEND 的 EXTRA_STREAM 优先), 类型经 SDK 描述符随 uri 捎带;
          // 无文件载荷的文本族记录 (按 SDK 层级归属 general.text) 的 content/链接地址进
          // 既有搜索/网页分流。文件记录多于一件时告知仅支持单文件, 不做部分导入。
          // 申报 = 本端真实能力 (字面量取自本机 SDK @ohos.data.uniformTypeDescriptor.d.ts,
          // MIME/后缀均见官方预置表):
          // - 文本族 TEXT/PLAIN_TEXT/HTML/HYPERLINK: 纯文本/网页链接与文本形态文件
          //   (.txt/.json 等; JSON 无专用 UTD, 系统报文本类)。general.xml 存在但本端无
          //   XML 配置导入链, 不申报。
          // - 书籍 general.epub / com.adobe.pdf (本端 PDF 阅读经官方 PDFKit 真实渲染); 电子书
          //   大类 general.ebook 与 com.amazon.* (mobi/azw3) 不在本端书籍识别链, 不申报。
          // - 压缩 general.zip-archive / general.tar-archive / org.gnu.gnu-zip-archive /
          //   org.gnu.gnu-zip-tar-archive (共有解包实现支持的四类; rar/7z/bz2/xz/lzma
          //   无 native 解码, 不申报)。
          // - 视频 general.mpeg-4 / org.matroska.mkv / general.ts (AVPlayer 承诺的三个
          //   文件容器; general.video 大类与 mov/flv/webm 不在承诺内, 不申报)。
          // 不配 entities: 官方分享接收示例只给 actions+uris, 多声明一个无法确认会被满足的
          // required entity 反而可能匹配不上。
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.plain-text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.html",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.epub",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "com.adobe.pdf",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.zip-archive",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.tar-archive",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "org.gnu.gnu-zip-archive",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "org.gnu.gnu-zip-tar-archive",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.mpeg-4",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "org.matroska.mkv",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.ts",
                "maxFileSupported": 1
              }
            ]
          }
        ],
        // 静态桌面快捷方式 (长按应用图标弹出), 对照 Android ShortCuts.kt 的三项
        // (书架 / 最近阅读 / 直接朗读; Android 用 ShortcutManagerCompat.setDynamicShortcuts
        // 动态注册, 鸿蒙只支持静态声明)。路由值/语义逐项依据见 $profile:shortcuts_config 的注释。
        // metadata 的 name 必须用 ohos.ability.shortcuts、resource 指向 profile 配置 —— 依据:
        // module-configuration-file.md「shortcuts标签」节 "name：指定shortcuts的名称，使用
        // ohos.ability.shortcuts作为shortcuts信息的标识" 及其示例 (metadata 挂在 abilities 条目下)。
        // 资源名 shortcuts_config 与文件 resources/base/profile/shortcuts_config.json 同名
        // ($profile: 按 profile 目录下文件名匹配)。
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ]
      }
    ]
  }
}
